{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:specspine:manifest:v4",
  "title": "SpecSpine v4 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specspine",
    "project",
    "implementation_freedom",
    "areas",
    "assets"
  ],
  "properties": {
    "specspine": {"const": 4},
    "project": {"type": "string", "minLength": 1},
    "implementation_freedom": {
      "enum": [
        "contract-equivalent",
        "architecture-constrained"
      ]
    },
    "presentation": {"$ref": "#/$defs/presentation"},
    "mapping": {"$ref": "#/$defs/mapping"},
    "areas": {
      "type": "array",
      "items": {"$ref": "#/$defs/area"}
    },
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontier", "observed_edges"],
      "properties": {
        "frontier": {
          "type": "array",
          "items": {"$ref": "#/$defs/frontierEntry"}
        },
        "observed_edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/observedEdge"}
        }
      }
    },
    "frontierEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "from_owner", "title", "question", "reason", "seed_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "from_owner": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "seed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "observedEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_owner", "target_owner", "observation"],
      "properties": {
        "source_owner": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "target_owner": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "observation": {
          "type": "string",
          "pattern": "^OBS-[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "language"],
      "properties": {
        "profile": {"const": 1},
        "language": {"type": "string", "minLength": 1},
        "headings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "responsibility": {"type": "string", "minLength": 1},
            "boundaries": {"type": "string", "minLength": 1},
            "behavior": {"type": "string", "minLength": 1},
            "interfaces": {"type": "string", "minLength": 1},
            "information-model": {"type": "string", "minLength": 1},
            "data-ownership": {"type": "string", "minLength": 1},
            "lifecycle-and-invariants": {"type": "string", "minLength": 1},
            "failure-behavior": {"type": "string", "minLength": 1},
            "edge-cases": {"type": "string", "minLength": 1},
            "configuration-contract": {"type": "string", "minLength": 1},
            "compatibility": {"type": "string", "minLength": 1},
            "requirements": {"type": "string", "minLength": 1},
            "guarantees": {"type": "string", "minLength": 1},
            "invariants": {"type": "string", "minLength": 1},
            "quality-constraints": {"type": "string", "minLength": 1},
            "verification": {"type": "string", "minLength": 1},
            "decisions": {"type": "string", "minLength": 1},
            "constraints": {"type": "string", "minLength": 1},
            "observed": {"type": "string", "minLength": 1},
            "inferred": {"type": "string", "minLength": 1},
            "open-questions": {"type": "string", "minLength": 1},
            "known-divergences": {"type": "string", "minLength": 1},
            "implementation": {"type": "string", "minLength": 1},
            "relationships": {"type": "string", "minLength": 1},
            "terminology": {"type": "string", "minLength": 1},
            "risks": {"type": "string", "minLength": 1},
            "rationale-and-trade-offs": {"type": "string", "minLength": 1}
          }
        },
        "section_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "responsibility", "boundaries", "behavior", "interfaces",
              "information-model", "data-ownership",
              "lifecycle-and-invariants", "failure-behavior", "edge-cases",
              "configuration-contract", "compatibility", "requirements",
              "guarantees", "invariants", "quality-constraints",
              "verification", "decisions", "constraints", "observed",
              "inferred", "open-questions", "known-divergences",
              "implementation", "relationships", "terminology", "risks",
              "rationale-and-trade-offs"
            ]
          }
        },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root-title": {"type": "string", "minLength": 1},
            "purpose": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "minLength": 1},
            "guide-heading": {"type": "string", "minLength": 1},
            "guide": {"type": "string", "minLength": 1},
            "glossary-heading": {"type": "string", "minLength": 1},
            "glossary": {"type": "string", "minLength": 1},
            "contents-heading": {"type": "string", "minLength": 1},
            "nested-heading": {"type": "string", "minLength": 1},
            "empty": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "facet": {
      "enum": ["complete", "partial", "missing", "not-applicable"]
    },
    "inspectionFacet": {
      "enum": ["checked", "not-checked"]
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "behavior",
        "interfaces",
        "data",
        "failure",
        "quality",
        "verification"
      ],
      "properties": {
        "architecture": {"$ref": "#/$defs/facet"},
        "behavior": {"$ref": "#/$defs/facet"},
        "interfaces": {"$ref": "#/$defs/facet"},
        "data": {"$ref": "#/$defs/facet"},
        "failure": {"$ref": "#/$defs/facet"},
        "quality": {"$ref": "#/$defs/facet"},
        "verification": {"$ref": "#/$defs/facet"}
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "facets", "blockers"],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "facets": {"$ref": "#/$defs/facets"},
        "inspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "inspected", "mode", "facets"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "inspected": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "mode": {
              "enum": ["survey", "deepen", "refresh", "drift"]
            },
            "facets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "architecture", "behavior", "interfaces", "data",
                "failure", "quality", "verification"
              ],
              "properties": {
                "architecture": {"$ref": "#/$defs/inspectionFacet"},
                "behavior": {"$ref": "#/$defs/inspectionFacet"},
                "interfaces": {"$ref": "#/$defs/inspectionFacet"},
                "data": {"$ref": "#/$defs/inspectionFacet"},
                "failure": {"$ref": "#/$defs/inspectionFacet"},
                "quality": {"$ref": "#/$defs/inspectionFacet"},
                "verification": {"$ref": "#/$defs/inspectionFacet"}
              }
            }
          }
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^OQ-[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "owner",
        "role",
        "format",
        "normative",
        "verifies"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "role": {
          "enum": [
            "interface-contract",
            "data-schema",
            "scenario",
            "fixture",
            "verification"
          ]
        },
        "format": {"type": "string", "minLength": 1},
        "normative": {"type": "boolean"},
        "verifies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^VER-[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
