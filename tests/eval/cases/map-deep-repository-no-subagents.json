{
  "id": "map-deep-repository-no-subagents",
  "scenario": "tests/scenarios/map-deep-repository-no-subagents.md",
  "skill": "skills/specspine-map",
  "status": "executable",
  "category": "expensive",
  "timeout_seconds": 1200,
  "subagents": "disabled",
  "report_artifacts": ["specspine/**/*.md"],
  "initial_tree": "tests/eval/fixtures/map-modes-six-area",
  "assertions": [
    {"type": "trace_equals", "field": "subagents_enabled", "value": false},
    {"type": "collab_spawn_count", "max": 0},
    {"type": "collab_tools_absent", "values": ["spawn_agent", "followup_task", "wait", "wait_agent"]},
    {"type": "command_excludes", "values": ["bundle_skill.py", "--candidates", "producer-instructions.md", "accept", "integration-pass"]},
    {"type": "command_includes", "value": "campaign.py"},
    {"type": "command_includes", "value": "inventory"},
    {"type": "command_includes", "value": "source-pass"},
    {"type": "response_contains", "value": "blocked"},
    {"type": "response_not_contains", "values": ["inventory_verified", "saturated", "$specspine-doctor"]},
    {"type": "path_absent", "path": ".specspine-map-run"},
    {"type": "glob_count", "glob": "specspine/**/*.md", "min": 2, "max": 2},
    {"type": "unchanged", "paths": ["src/**", "tests/**", "config/**"]},
    {"type": "changed_only", "paths": ["specspine/**"]},
    {"type": "markdown_links_valid", "glob": "specspine/**/*.md"},
    {"type": "semantic_ids_valid", "glob": "specspine/**/*.md"}
  ]
}
