{
  "id": "map-sequential-saturation-small",
  "scenario": "tests/scenarios/map-sequential-saturation-small.md",
  "skill": "skills/specspine-map",
  "status": "executable",
  "category": "expensive",
  "timeout_seconds": 1200,
  "repeat_until_unchanged": {
    "paths": ["specspine/**"],
    "min_runs": 2,
    "max_runs": 10
  },
  "report_artifacts": ["specspine/**/*.md"],
  "initial_tree": "tests/eval/fixtures/map-modes-six-area",
  "assertions": [
    {"type": "glob_count", "glob": "specspine/**/*.md", "min": 6, "max": 12},
    {"type": "glob_contains", "glob": "specspine/**/*.md", "values": ["src/identity/session.js", "config/identity.json", "src/jobs/runner.js", "config/jobs.json", "src/telemetry/exporter.js", "config/telemetry.json", "src/notifications/router.js", "config/notifications.json", "src/search/index.js", "config/search.json", "src/webhooks/receiver.js", "config/webhooks.json"]},
    {"type": "unchanged", "paths": ["src/**", "tests/**", "config/**"]},
    {"type": "changed_only", "paths": ["specspine/**"]},
    {"type": "markdown_links_valid", "glob": "specspine/**/*.md"},
    {"type": "semantic_ids_valid", "glob": "specspine/**/*.md"}
  ]
}
