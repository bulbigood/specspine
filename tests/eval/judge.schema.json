{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["pass", "score", "rationale", "evidence", "efficiency"],
  "properties": {
    "pass": {"type": "boolean"},
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "rationale": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "efficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "rationale"],
      "properties": {
        "rating": {"enum": ["efficient", "acceptable", "inefficient"]},
        "rationale": {"type": "string"}
      }
    }
  }
}
